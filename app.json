{
  "expo": {
    "name": "FixMatch",
    "slug": "FixMatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Headlineless-logo.png",
    "scheme": "fixmatch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/images/Headlineless-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDEB"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Headlineless-logo.png",
        "backgroundColor": "#FFFDEB"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.andres_4081.FixMatch"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Headlineless-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFDEB"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e11784d4-09f4-4c53-ab53-10426bded97d"
      }
    }
  }
}
